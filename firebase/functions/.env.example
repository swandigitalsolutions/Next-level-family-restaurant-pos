# Cloud Functions runtime configuration. Copy to `.env` for the emulator, or set
# these with `firebase functions:secrets:set` / `--set-env-vars` at deploy time.
# NEVER commit real values. `.env` is gitignored.

# --- Website integration (server-to-server) -------------------------------
# Comma-separated allow-list. The separate Website project's server holds one of these.
WEBSITE_API_KEYS=

# --- Restaurant locale --------------------------------------------------
RESTAURANT_TZ=Asia/Kolkata
RESTAURANT_NAME=Next Level Family Restaurant

# --- Payments (Razorpay) ----------------------------------------------
# Production MUST be "razorpay". Any other value (incl. unset) fails closed
# outside the emulator unless ALLOW_MOCK_PAYMENTS=true is also set.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx     # public — returned to the browser as payment.keyId
RAZORPAY_KEY_SECRET=                      # SECRET — set via functions:secrets:set
RAZORPAY_WEBHOOK_SECRET=                  # SECRET — HMAC key for X-Razorpay-Signature
# ALLOW_MOCK_PAYMENTS=true                # opt-in ONLY for a non-emulator test project

# --- Abuse protection ------------------------------------------------
# true => require a Firebase App Check token on the public qrApi endpoints.
ENFORCE_APP_CHECK=true
