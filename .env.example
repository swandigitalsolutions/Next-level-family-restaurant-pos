# Copy to backend/.env for local runs, or set these in the Render dashboard.
# Do NOT commit a real .env (it is gitignored).

# Flask session signing key. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Name shown on the customer QR menu and on printed bills.
RESTAURANT_NAME=Next Level Family Restaurant

# Base URL encoded into printed table QR codes. Leave unset and the app uses the
# host the staff request arrived on -- which is wrong if you print QR codes while
# browsing on 127.0.0.1, because a customer's phone cannot reach that. Set it to
# your LAN address for local testing (e.g. http://192.168.1.13:5000) or to your
# public domain in production.
# PUBLIC_BASE_URL=https://next-level-family-restaurant.onrender.com

# --- Database -------------------------------------------------------------
# If DATABASE_URL is set, the app uses PostgreSQL; otherwise it uses the
# bundled SQLite file (backend/nextlevel.db).
#
# Supabase: Project Settings -> Database -> Connection string -> use the
# "Transaction pooler" URI (IPv4, works from Render). Example shape:
# DATABASE_URL=postgresql://postgres.abcdefgh:[email protected]:6543/postgres
#
# DATABASE_URL=

# SQLite-only: where the database file lives. Leave unset to use the bundled
# file. Ignored when DATABASE_URL is set.
# DB_PATH=/data/nextlevel.db

# Set on Render to enable Secure cookies + reverse-proxy header trust.
# RENDER=true

# Local day used for bill timestamps and the dashboard "today" figures.
TZ=Asia/Kolkata

# Local dev port (Render injects its own PORT).
PORT=5000
